/*
 * naan_init.nlg
 * Naanide
 *
 * Loaded automatically to initialize the main Naanide browser thread.
 *
 * column positioning:                          //                          //                      !
 *
 * Copyright (c) 2017-2026 by Richard C. Zulch
 *
 */

loglevel(3);
chns("Start");

defineExt("nlg", true);                                                     // our code extension


/*
 * Debugging & Tools
 *
 */

if !module.owner.list.running.components.debugnub {
    require("naanlib:frameworks/common/repltools.nlg").ImportReplTools()
    require("naanlib:frameworks/running/debugnub.nlg").DebugNub()
};


/*
 * loadSecret
 * storeSecret
 *
 *     We have to track the secret API-access guid separately because the main persistence is
 * version-dependent, and if we reload we might be changing versions.
 *
 */

function loadSecret() {
    try {
        js.w.localStorage.getItem("Nide_Guid")
    } catch {
        ErrorDebuglog("loadSecret exception", exception)
        false
    }
};

function storeSecret(guid) {
    try {
        js.w.localStorage.removeItem("Nide_Guid")
        js.w.localStorage.setItem("Nide_Guid", guid)
    } catch {
        ErrorDebuglog("storeSecret exception", exception)
        false
    }
};


/*
 * loadSession
 * saveSession
 *
 *     Persistent access for session data without leakage. This ensures that any data element stored
 * with sessionSave is only saved in the current session and does not "leak" into the saved state
 * for all sessions. The '.inst' field of the appSession is cleared on duplicates.
 *
 */

appSession = false;
bcSession = false;

function saveSession() {
    try {
        js.w.sessionStorage.removeItem("Nide_Session")
        js.w.sessionStorage.setItem("Nide_Session", js.w.JSON.stringify(appSession))
        true
    } catch {
        ErrorDebuglog("saveSession exception", exception)
        false
    }
};

function loadSession(local comMod, key, data) {
    comMod = require("naanlib:frameworks/common")
    try {
        appSession = new(nonce)                                             // nonce is not persisted
        for `(key, data) in new(js.w.JSON.parse(js.w.sessionStorage.getItem("Nide_Session")))
            appSession[key] = data
        appSession.saveSession = saveSession
        if !appSession.\.inst
            appSession.\.inst = {                                           // default session
                instanceID: comMod.UUID()
            }
        if appSession._duplicate_reload {
            appSession.\.inst = {                                           // need new UUID
                instanceID: comMod.UUID()
            }
            appSession._duplicate_reload = undefined
            saveSession()
        } else
            dupeSessionCheck()
    } catch {
        ErrorDebuglog("loadSession exception", exception)
    }
};


/*
 * dupeSessionCheck
 *
 *     Check for a duplicate session with another tab, which is annoying. This uses a broadcast
 * channel to see if an existing tab is using our prospective new instanceID. If so then we clear
 * .inst from our session storage and reload. We have to reload the page because we don't how long
 * it's been since we started, because we don't know how long it will take for all the responders
 * to broadcast back to us. Could easily be a second with Chrome due to throttling, but definitely
 * slower than our first use of the id.
 *
 * Note: it is absolutely essential to reload the page with the restart parameter, because if you
 * try to use saved state then Chromium browsers (as of 20260902) lose their teeny-weeny little
 * minds and fall on their sword and die and steal your debugging time while you trace things like
 * failed fetch calls that don't show up in DevTools. Strongly advise you not revisit this drama.
 *
 */

function dupeSessionCheck(local url) {
    if !bcSession {
        bcSession = xnew(js.w.BroadcastChannel, "NaanIDE-instanceID-check")
        bcSession.addEventListener("message", function(event, local msg) {
            msg = new(event.data)
            if msg.op == "check" && msg.id == appSession.\.inst.instanceID {
                bcSession.postMessage({                                     // we were duplicated
                    op: "duplicate"
                    id: appSession.\.inst.instanceID
                })
            } else if msg.op == "duplicate" && msg.id == appSession.\.inst.instanceID {
                appSession._duplicate_reload = true
                saveSession()
                js.t.Working()                                              // preserve saved state
                url = xnew(js.w.URL, js.w.location.href)
                url.searchParams.set("restart", "1")
                js.w.location.replace(url.href)
            }
        })
    }
    if appSession.\.inst.instanceID
        bcSession.postMessage({
            op: "check"
            id: appSession.\.inst.instanceID
        })
};


/*
 * loadNide
 *
 *     Load Naanide into the browser, whether for the first time or after reload.
 *
 */

serverurl = js.w.location.protocol.concat("//", js.w.location.host);
authState = { };

function loadNide(local hostpath, baseurl, guid, url, bapi, bide, bui) {
    hostpath = js.w.location.origin.concat(js.r("path").dirname(js.w.location.pathname))
    if hostpath.slice(-1) != "/"
        hostpath = hostpath.concat("/")                                     // must end in "/"
    baseurl = js.w.location.href.split(RegExp("[?#]"))[0]                   // URL without variables or hashes
    url = xnew(js.w.URL, js.w.location.href)
    guid = url.searchParams.get("guid")
    if guid {                                                               // remove the GUID from the visible URL
        storeSecret(guid)
        authState.guid = guid
    }
    else
        guid = loadSecret()                                                 // see if we have stored the GUID
    url.searchParams.delete("guid")
    url.searchParams.delete("restart")
    js.w.history.replaceState(authState, "", url)
    loadSession()
    App.imp = require("naanlib:frameworks/service/imp.nlg").Imp({
        name: "NaanIDE"
        type: "Client IMP"
        instanceID: appSession.\.inst.instanceID
        meta: {
            host: baseurl
        }
        services: [ "discovery", "naan-remote-responder" ] })
    bapi = require("naanlib:frameworks/client/apiclient.nlg").APIClient(App.imp, {
        url: hostpath
        guid: guid
    })
    `(error) = bapi.connect()
    if error
        ErrorDebuglog("NaanIDE: cannot connect to our server", error)
    bide = require("nide/nideClient/nideClient.nlg").NideController(bapi, appSession)
    bui = require("nide/nideUI/nideUI.nlg").MakeNideUI(bide)
    bide.setUI(bui)
    saveSession()
} ();

module.postload = loadNide;                                                 // called again after reload
